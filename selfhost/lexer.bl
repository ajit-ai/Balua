// Balua self-hosted lexer — mirrors crates/baluac/src/lexer.rs
// Keywords: async await break const continue else for if let loop match pub priv
//           return spawn chan send recv select struct fn where unsafe while loop

fn is_keyword(lexeme: str) -> bool {
    match lexeme {
        "async" | "await" | "break" | "const" | "continue" | "else" | "for" | "if" | "let" | "loop" | "match" | "pub" | "priv" | "return" | "spawn" | "chan" | "send" | "recv" | "select" | "struct" | "fn" | "where" | "unsafe" | "while" | "trusted" | "safe" => true, _ => false, 
}
}

fn tokenize(src: str) -> Vec < Token > {
    let mut tokens: Vec < Token > = Vec::new();
    let mut i = 0;
    while i < src . len() {
        let c = src[i];
        if c . is_whitespace() {
            i = i + 1;
            continue;
        }
        if c . is_digit() {
            let start = i;
            while i < src . len() && src[i] . is_digit() {
                i = i + 1;
            }
            tokens . push(Token::new(LiteralInt, & src[start..i]));
            continue;
        }
        if c . is_alpha() || c == '_' {
            let start = i;
            while i < src . len() && (c . is_alphanumeric() || c == '_') {
                i = i + 1;
            }
            let lexeme = & src[start..i];
            let kind = if is_keyword(lexeme) {
                Keyword
}
            else {
                Identifier
};
            tokens . push(Token::new(kind, lexeme));
            continue;
        }
        tokens . push(Token::new(Operator, & c . to_string()));
        i = i + 1;
    }
    tokens . push(Token::new(Eof, ""));
    tokens
}

fn lex(src: str) -> Vec < Token > {
    tokenize(src)
}
