// Balua self-hosted parser — mirrors crates/baluac/src/parser.rs
// Implements recursive-descent parsing for Balua Stage 2 AST.

fn parse_program(src: str) -> Program {
    let tokens = lex(src);
    let mut parser = Parser::new(tokens);
    parser.parse_program()
}

fn parse_fn_decl(tokens: Vec<Token>) -> FnDecl {
    let mut p = Parser::new(tokens);
    p.parse_fn_decl()
}

fn parse_expr(tokens: Vec<Token>) -> Expr {
    let mut p = Parser::new(tokens);
    p.parse_expr()
}

fn parse_block(tokens: Vec<Token>) -> Block {
    let mut p = Parser::new(tokens);
    p.parse_block()
}

fn parse_const_decl(tokens: Vec<Token>) -> ConstDecl {
    let mut p = Parser::new(tokens);
    p.parse_const_decl()
}

fn parse_struct(tokens: Vec<Token>) -> StructDecl {
    let mut p = Parser::new(tokens);
    p.parse_struct()
}

fn parse_enum(tokens: Vec<Token>) -> EnumDecl {
    let mut p = Parser::new(tokens);
    p.parse_enum()
}

fn parse_trait(tokens: Vec<Token>) -> TraitDecl {
    let mut p = Parser::new(tokens);
    p.parse_trait()
}

fn parse_impl(tokens: Vec<Token>) -> ImplDecl {
    let mut p = Parser::new(tokens);
    p.parse_impl()
}

fn parse_ffi(tokens: Vec<Token>) -> FFIDecl {
    let mut p = Parser::new(tokens);
    p.parse_ffi()
}

fn parse_unsafe(tokens: Vec<Token>) -> UnsafeBlock {
    let mut p = Parser::new(tokens);
    p.parse_unsafe()
}

fn parse_type(tokens: Vec<Token>) -> TypeExpr {
    let mut p = Parser::new(tokens);
    p.parse_type()
}

fn parse_var_decl(tokens: Vec<Token>) -> VarDecl {
    let mut p = Parser::new(tokens);
    p.parse_var_decl()
}

fn synchronize(tokens: Vec<Token>) -> Vec<Token> {
    let mut p = Parser::new(tokens);
    p.synchronize();
    p.tokens
}
