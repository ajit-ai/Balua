// 06a_selfhost — self-hosted lexer/parser mirror (Phase 8)
// This file demonstrates Balua parsing itself
module main {
    // Keywords: pub, priv, const, fn, safe, unsafe, trusted
    pub const SELF_HOSTED: bool = true;
    priv const VERSION: i32 = 1;

    // Safe function — compiler verified
    pub fn safe lex(src: str) -> i32 {
        src.len()
    }

    // Safe function — parser
    pub fn safe parse(tokens: str) -> i32 {
        tokens.len()
    }

    // Trusted — bootstrapping entry point
    pub fn trusted bootstrap() -> i32 {
        let src = "fn main() -> i32 { 0 }";
        let tokens = lex(src);
        let _ast = parse(tokens);
        1
    }

    fn main() -> i32 {
        let a = lex("fn main() -> i32 { 0 }");
        let b = parse("tokens");
        let c = bootstrap();
        if c == 1 && a > 0 && b > 0 {
            println("06a_selfhost: self-host lexer/parser working")
        };
        0
    }
}
