// 04_npu_image_classify — MobileNetV3 ONNX inference (Section 11)
module main {
    use std::hal::npu::NpuModel;

    @hw::npu(backend = onnx) tensor fn inference(x: Tensor < f16, [1, 3, 224, 224] > ) -> Tensor < f32, [1, 1000] > {
        // Dispatched via ONNX/TensorRT — simulation fallback runs CPU
        Tensor {
            data: [0.0;
            1000]
}
    }

    fn main() -> i32 {
        let model = NpuModel::load_onnx("mobilenetv3.onnx") . unwrap();
        let img: Tensor < f16, [1, 3, 224, 224] > = Tensor {
            data: [0 as f16;
            150528]
};
        let out = model . infer(img);
        println("Top-5: {:?}", & out . data[0..5]);
        0
}
}
