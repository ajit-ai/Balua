// 01_hello_hardware — detect all silicon (Section 11)
module main {
    use std::hal::cpu;
    use std::hal::gpu;
    use std::hal::npu;
    use std::hal::fpga;
    use std::hal::quantum;

    fn main() -> i32 {
        println("Hello from Balua!");
        println("CPU cores: {}", cpu::core_count());
        println("GPU available: {}", true); // probe in real HAL
        println("NPU backend: {:?}", npu::detect_backend());
        println("FPGA bitstream loaded: {}", false);
        println("Quantum qubits: {}", 5);
        0
    }
}
// README: blpkg run — works on any host (simulation fallback)
