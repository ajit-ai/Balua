// 01b_parallelism — spawn, chan, send, recv, select (Phase 3)
module main {
    // spawn — launch a concurrent task
    fn spawn_task() -> i32 {
        spawn {
            let _x = 1
};
        0
}

    // chan — create a channel, send, recv
    fn chan_test() -> i32 {
        let c = chan i32;
        send c 42;
        let _r = recv c;
        0
}

    // select — wait on multiple channels
    fn select_test() -> i32 {
        select {
            ch1 => {
                let _a = 1
}
            , ch2 => {
                let _b = 2
}
            , 
};
        0
}

    // combined parallelism pattern
    fn pipeline() -> i32 {
        let data = chan i32;
        spawn {
            let _result = recv data;
        };
        send data 100;
        select {
            data => {
                let _v = recv data
}
            , ch_timeout => {
                let _t = 0
}
            , 
};
        0
}

    fn main() -> i32 {
        let a = spawn_task();
        let b = chan_test();
        let c = select_test();
        let d = pipeline();
        if a == 0 && b == 0 && c == 0 && d == 0 {
            println("01b_parallelism: spawn/chan/send/recv/select all working")
};
        0
}
}
