    pub struct BRAM < T, const N: usize > {
        data: [T;
        N]
}
    pub struct URAM < T, const N: usize > {
        data: [T;
        N]
}
    impl < T, const N: usize > BRAM < T, N > {
        pub fn new() -> Self where T: Default + Copy {
            Self {
                data: [T::default();
                N]
}
        }
    }

    pub fn dsp_multiply_accumulate(a: i32, b: i32, acc: i32) -> i32 {
        a * b + acc
}

