pub const MAX: i32 = 100;
fn factorial(n: i32) -> i32 {
    let mut r = 1;
    while n > 1 {
        r = r * n;
        n = n - 1;
    };
    r
}
fn loop_test() -> i32 {
    let mut i = 0;
    loop {
        i = i + 1;
        if i == 5 {
            break i;
        }
    };
    i
}
fn match_test(x: i32) -> i32 {
    match x {
        1 => 10, 2 => 20, _ => 0
};
    x
}
fn for_test() -> i32 {
    let mut s = 0;
    for i in 0..5 {
        s = s + i;
    };
    s
}
fn continue_test() -> i32 {
    let mut s = 0;
    for i in 0..10 {
        if i % 2 == 0 {
            continue;
        };
        s = s + i;
    };
    s
}
fn where_test < T: Ord, K: Copy > (a: T, b: K) -> T {
    a
}
fn main() -> i32 {
    0
}
