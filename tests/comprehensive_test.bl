// tests/comprehensive_test.bl — full test suite covering all 9 phases
// Phase 2a: keywords (const, match, for, while, loop, break, continue, where, pub/priv, cast)
// Phase 2b: LLVM backend (--emit-llvm, --emit-mir)
// Phase 3: parallelism (spawn, chan, send, recv, select)
// Phase 4: safety tiers (safe, unsafe, trusted)
// Phase 5: GPU/NPU (wmma PTX)
// Phase 6: FPGA/Quantum (HLS, OpenQASM)
// Phase 7: DX/Observability (--verbose, profile)
// Phase 8: self-host (.bl source)
// Phase 9: ecosystem (docs, SBOM)

// ===== Phase 2a: Keywords =====
pub const MAX_ITERS: i32 = 100;

pub fn factorial(n: i32) -> i32 {
    let mut result = 1;
    let mut i = n;
    while i > 1 {
        result = result * i;
        i = i - 1;
    };
    result
}

pub fn loop_test() -> i32 {
    let mut i = 0;
    loop {
        i = i + 1;
        if i == 5 { break i; };
    };
    i
}

pub fn match_test(x: i32) -> i32 {
    match x {
        1 => 10,
        2 => 20,
        _ => 0,
    };
    x
}

pub fn for_test() -> i32 {
    let mut s = 0;
    for i in 0..5 {
        s = s + i;
    };
    s
}

pub fn continue_test() -> i32 {
    let mut s = 0;
    for i in 0..10 {
        if i % 2 == 0 { continue; };
        s = s + i;
    };
    s
}

pub fn cast_test(x: i32) -> f32 {
    x as f32
}

// ===== Phase 3: Parallelism =====
pub fn spawn_task() -> i32 {
    spawn { let x = 1; };
    0
}

pub fn chan_test() -> i32 {
    let c = chan i32;
    send c 42;
    let _r = recv c;
    0
}

pub fn select_test() -> i32 {
    select {
        ch1 => { let a = 1; },
        ch2 => { let b = 2; },
    };
    0
}

// ===== Phase 4: Safety Tiers =====
pub fn safe safe_func(a: i32, b: i32) -> i32 { a + b }

pub fn unsafe unsafe_div(a: i32, b: i32) -> i32 { a / b }

pub fn trusted trusted_audit() -> i32 { 42 }

// ===== Phase 5: GPU/NPU =====
@hw::gpu fn gpu_kernel(a: i32, b: i32) -> i32 { a * b }

// ===== Phase 6: FPGA/Quantum =====
@hw::fpga fn fpga_kernel(a: i32) -> i32 { a + 1 }

// ===== Phase 9: Pub/Priv visibility =====
pub fn public_api() -> i32 { 1 }
priv fn internal_helper() -> i32 { 2 }

// ===== Main test runner =====
fn main() -> i32 {
    assert(factorial(5) == 120);
    assert(loop_test() == 5);
    assert(match_test(1) == 10);
    assert(match_test(2) == 20);
    assert(match_test(99) == 0);
    assert(for_test() == 10);
    assert(continue_test() == 25);
    assert(cast_test(42) == 42.0);
    assert(spawn_task() == 0);
    assert(chan_test() == 0);
    assert(select_test() == 0);
    assert(safe_func(1, 2) == 3);
    assert(unsafe_div(10, 2) == 5);
    assert(trusted_audit() == 42);
    assert(gpu_kernel(3, 4) == 12);
    assert(fpga_kernel(5) == 6);
    assert(public_api() == 1);
    assert(internal_helper() == 2);
    assert(MAX_ITERS == 100);
    0
}

fn assert(cond: bool) {
    if cond == false { panic!("assertion failed"); }
}
