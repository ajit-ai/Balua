// tests/hal/*_sim_tests.bl — simulation fallback tests (no hardware needed) (Section 4 constraint)
module sim_tests {
    use std::hal::cpu;
    use std::hal::gpu;
    use std::hal::npu;

    #[test(sim=true)]
    fn test_cpu_fallback() {
        assert(cpu::core_count() > 0);
    }

    #[test(sim=true)]
    fn test_gpu_fallback() {
        let buf = gpu::DeviceBuf::< f32 > ::alloc(16);
        assert(buf . len() == 16);
    }

    #[test(sim=true)]
    fn test_npu_fallback() {
        let m = npu::NpuModel::load_onnx("dummy.onnx") . unwrap();
        assert(true);
    }
}
